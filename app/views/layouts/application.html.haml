!!!
%html{lang: 'en'}
  = render 'shared/head'
  %body
    = render 'shared/bed'
    %header.site-header
      %a.mark{href: root_path}
        = image_tag 'mark.svg', alt: '', width: 34, height: 34
        makeabox
      %nav{'aria-label': 'Sections'}
        %a{href: '#how'} How the tabs work
        %a{href: '#discussion'} Discussion
        %a{href: 'https://github.com/kigster/laser-cutter'} GitHub
        %a{href: '#support'} Donate
    = yield
    = render 'shared/footer'
