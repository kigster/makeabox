%a{href: "https://github.com/kigster/laser-cutter/fork", style: "z-index: 10000;"}
  %img#fork-me{alt: "Fork me on GitHub", "data-canonical-src": image_path("fork-me.png"), src: image_path("fork-me.png") }/
.row
  .col-10
    %nav.navbar
      = link_to image_tag('logo-with-gray.png', class: 'logo-image'), '/'
      %h1.logo make a box
  .col-2
    %nav.navbar
      %div.mr-5.pr-5.pt-2.shadow-lg.rounded-4
        - if current_user
          = button_to "Logout", destroy_user_session_path(current_user), method: :delete, class: 'btn btn-large btn-danger'
        - else
          - unless controller.request.env['PATH_INFO'] =~ %r{/users/sign_up}
            = link_to "Signup", new_user_registration_path, method: :get, class: 'btn btn-primary m-2 btn-large'
          - unless controller.request.env['PATH_INFO'] =~ %r{/users/sign_in}
            = link_to "Login", new_user_session_path, method: :get, class: 'btn btn-success m-2 btn-large'
