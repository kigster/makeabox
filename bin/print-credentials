#!/usr/bin/env ruby
# vim: ft=ruby 

require 'rails'
require 'active_support'
require 'active_support/encrypted_file'
require 'yaml'

credentials = begin
                # Full path or releative path to config folder
                env_path = "./config"
                contents = ActiveSupport::EncryptedFile.new(content_path: "#{env_path}/credentials.yml.enc",
                                                             key_path: "#{env_path}/master.key",
                                                             env_key: "development",
                                                             raise_if_missing_key: true)
                puts contents.read
                YAML.load(contents).deep_transform_keys(&:to_sym)
              rescue StandardError => e
                puts e.inspect
                puts e.backtrace.join("\n")
              end

credentials
